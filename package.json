{
  "name": "puzzle-game",
  "version": "1.0.0",
  "private": true,
  "description": "Sliding puzzle game with a proven solvability check",
  "license": "MIT",
  "author": "Nazima Jumaniyazova",
  "type": "module",
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsc -b && vite build",
    "dev": "vite",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 && stylelint \"src/**/*.css\" && cspell --no-progress --gitignore \"**/*.{ts,md,css,html}\" && knip",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "prepare": "husky",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.5.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.10",
    "@vitest/coverage-v8": "5.1.2",
    "@vitest/eslint-plugin": "1.6.28",
    "cspell": "10.5.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "9.1.7",
    "knip": "6.48.0",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "prettier-plugin-packagejson": "3.1.0",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "stylelint-declaration-strict-value": "1.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  }
}
